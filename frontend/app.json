{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.classnotify.hl9igt",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan member booking QR codes for class check-in",
        "NSPhotoLibraryUsageDescription": "Attach a photo to your membership application",
        "NSCalendarsUsageDescription": "Add your class bookings to your calendar",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add your class bookings to your calendar"
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.classnotify.hl9igt",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo to your membership application",
          "cameraPermission": "Take a photo for your membership application"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan member booking QR codes for class check-in"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Add your class bookings to your calendar"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}